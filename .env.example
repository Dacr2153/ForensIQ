# FILE: .env.example
# ForensIQ — Environment Configuration
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# ⚠ IMPORTANT: Never commit .env to version control.
#   It may contain sensitive paths or API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Volatility 3 ─────────────────────────────────────────────────────────────
# Path to the Volatility 3 `vol` executable.
# After `pip install volatility3` it's usually in your venv's bin/.
# On Arch Linux with system Python: /usr/bin/vol
# With a virtualenv: .venv/bin/vol
FORENSIQ_VOLATILITY_PATH=vol

# ─── Ollama LLM Service ───────────────────────────────────────────────────────
# Base URL of the Ollama API server.
# Local default: http://localhost:11434
# Docker Compose: http://ollama:11434 (set automatically in docker-compose.yml)
FORENSIQ_OLLAMA_BASE_URL=http://localhost:11434

# Model to use for YARA rule generation and the executive summary.
# This is the PREFERRED model: if it is not installed, ForensIQ automatically
# falls back to any installed model (curated preference: mistral, llama, qwen,
# phi, gemma, codellama, deepseek; else the first available model).
# If no model is installed at all, analysis still completes and a rule-based
# (non-AI) executive summary is produced.
# Recommended: mistral:7b (4.1 GB) — best balance of speed and quality.
# Alternatives: qwen2.5-coder:7b, llama3:8b, codellama:7b
# Pull with: ollama pull mistral:7b
FORENSIQ_OLLAMA_MODEL=mistral:latest

# Timeout in seconds for LLM responses.
# YARA generation may take 20-90s depending on hardware.
# Increase to 300 on slow machines, decrease to 60 on GPU-accelerated setups.
FORENSIQ_OLLAMA_TIMEOUT=120

# ─── ML Model ─────────────────────────────────────────────────────────────────
# Path to the trained XGBoost model (joblib format).
# Generate with: make train  (after downloading CIC-MalMem2022 dataset)
FORENSIQ_MODEL_PATH=./ml/data/forensiq_model.joblib

# ─── Output Directories ──────────────────────────────────────────────────────
# Directory where HTML forensic reports are saved.
FORENSIQ_REPORTS_DIR=./reports

# Directory where generated and validated YARA rules are saved.
FORENSIQ_YARA_RULES_DIR=./yara_rules

# ─── Analysis Database ─────────────────────────────────────────────────────────
# Path to the SQLite database for analysis history + threat-intel cache.
# Leave empty to use the default: ~/.forensiq/forensiq.db
FORENSIQ_DB_PATH=

# ─── Analysis Limits ─────────────────────────────────────────────────────────
# Maximum number of processes to analyze from a memory dump.
# Reduce to 100 for faster analysis on large dumps.
# Set to 0 for unlimited (may be slow on dumps with 500+ processes).
FORENSIQ_MAX_PROCESSES_ANALYZE=500

# ─── Detection Configuration ─────────────────────────────────────────────────
# Probability threshold above which a process is classified as malicious.
# Range: 0.0 to 1.0
# - Lower (e.g. 0.50): More detections, higher false positive rate
# - Higher (e.g. 0.80): Fewer detections, lower false positive rate
# Recommended: 0.65 (calibrated for CIC-MalMem2022 test set)
FORENSIQ_THREAT_THRESHOLD=0.65

# Enable/disable YARA rule generation via Ollama.
# Set to false if Ollama is not running or not needed.
FORENSIQ_YARA_GENERATE=true

# ─── Threat Intelligence (optional) ───────────────────────────────────────────
# Root directory used to resolve DLL content files for artifact content hashing.
# During offline Windows dump analysis the original DLL files are not present
# on the analysis host. Set this to the mount point or copied tree of the
# suspect system's files so ForensIQ can compute genuine SHA-256 content hashes
# for suspicious DLLs and fire real VirusTotal / MalwareBazaar lookups.
# Leave empty for live Linux analysis, where /proc/PID/maps paths are real files.
FORENSIQ_DLL_ROOT=

# VirusTotal API v3 key for hash-based IOC lookups on suspicious DLLs.
# Threat-intel is VirusTotal-first: only content hashes of suspicious DLLs are
# queried (batched, rate-limited to the free-tier 4 req/min). MalwareBazaar is
# used as a secondary fallback for hashes VT could not resolve. Results are
# cached locally for 24h.
# Leave empty to disable the threat-intel detector entirely (no network I/O).
# Get a key: https://www.virustotal.com/gui/join-us
FORENSIQ_VT_API_KEY=

# ─── Logging ─────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
FORENSIQ_LOG_LEVEL=INFO

# Log format: json (for production/pipelines) | console (for development)
# json → structured JSON lines (compatible with ELK, Splunk, etc.)
# console → human-readable colored output
FORENSIQ_LOG_FORMAT=console
